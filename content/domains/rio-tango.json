  "concepts": [
    {
      "conceptId": "lunfardo",
      "domainId": "rio-tango",
      "areaIds": [
        "lunfardo-basics"
      ],
      "difficulty": 2,
      "competences": [
        "domain-knowledge",
        "terminology-usage"
      ],
      "sourceIds": [
        "tango-culture"
      ],
      "inferred": false,
      "terms": {
        "en": {
          "term": "lunfardo (Buenos Aires slang)",
          "alternatives": [
            "porteño slang"
          ],
          "register": "cultural"
        },
        "es": {
          "term": "lunfardo",
          "alternatives": [
            "jerga porteña"
          ],
          "register": "cultural"
        },
        "zh": {
          "term": "布宜诺斯艾利斯俚语",
          "alternatives": [
            "lunfardo"
          ],
          "register": "cultural"
        }
      },
      "definition": {
        "en": "The slang born in Buenos Aires' port barrios — Italian immigrant words, vesre syllable-flips, prison and street poetry — that tango lyrics run on."
      },
      "distinctions": [
        {
          "contrast": "standard slang / jargon",
          "difference": "Lunfardo carries barrio identity and nostalgia; translating it as neutral 'slang' erases who is speaking and where from."
        }
      ],
      "misconceptions": [
        {
          "tag": "lunfardo-as-neutral",
          "description": "Flattening lunfardo into neutral Spanish/English",
          "diagnosticPrompt": "A singer calls himself a 'pibe de arrabal'. Keep the barrio in English."
        }
      ],
      "examples": [
        {
          "en": "Lunfardo is the accent of the old port barrios.",
          "es": "El lunfardo es el acento de los viejos barrios portuarios.",
          "zh": "Lunfardo 是老港口街区的口音。"
        }
      ],
      "relationships": []
    },
    {
      "conceptId": "chamuyo",
      "domainId": "rio-tango",
      "areaIds": [
        "lunfardo-basics"
      ],
      "difficulty": 2,
      "competences": [
        "terminology-usage",
        "meaning-transfer"
      ],
      "sourceIds": [
        "tango-culture"
      ],
      "inferred": false,
      "terms": {
        "en": {
          "term": "chamuyo (sweet-talk / patter)",
          "alternatives": [
            "smooth talk"
          ],
          "register": "slang"
        },
        "es": {
          "term": "chamuyo",
          "alternatives": [
            "verso"
          ],
          "register": "slang"
        },
        "zh": {
          "term": "花言巧语",
          "alternatives": [
            "chamuyo"
          ],
          "register": "slang"
        }
      },
      "definition": {
        "en": "Fluent, charming patter — seduction, salesmanship, or gentle con — where the music of the talk matters more than its truth."
      },
      "distinctions": [
        {
          "contrast": "conversation / charla",
          "difference": "Chamuyo is performance with an agenda (win her, sell it, charm them); 'chat' loses the wink."
        }
      ],
      "misconceptions": [
        {
          "tag": "chamuyo-as-chat",
          "description": "Translating chamuyo as plain conversation",
          "diagnosticPrompt": "'No me chamuyes' — render the accusation, not a chat log."
        }
      ],
      "examples": [
        {
          "en": "Don't sweet-talk me — I know that chamuyo.",
          "es": "No me chamuyes — ese chamuyo ya lo conozco.",
          "zh": "别跟我花言巧语——这套我听过。"
        }
      ],
      "relationships": []
    },
    {
      "conceptId": "guita",
      "domainId": "rio-tango",
      "areaIds": [
        "lunfardo-basics"
      ],
      "difficulty": 1,
      "competences": [
        "bilingual-terminology"
      ],
      "sourceIds": [
        "tango-culture"
      ],
      "inferred": false,
      "terms": {
        "en": {
          "term": "guita (money, dough)",
          "alternatives": [
            "cash"
          ],
          "register": "slang"
        },
        "es": {
          "term": "guita",
          "alternatives": [
            "plata"
          ],
          "register": "slang"
        },
        "zh": {
          "term": "钱（俚语）",
          "alternatives": [
            "guita"
          ],
          "register": "slang"
        }
      },
      "definition": {
        "en": "Lunfardo for money — the dough that tango heroes never have and always sing about losing."
      },
      "distinctions": [
        {
          "contrast": "dinero (neutral)",
          "difference": "Guita is street register; in a lyric, 'money' is flat where 'dough' keeps the shine."
        }
      ],
      "misconceptions": [
        {
          "tag": "guita-register",
          "description": "Register-flat rendering of guita",
          "diagnosticPrompt": "'Sin guita y sin amor' — keep both bankruptcies poetic."
        }
      ],
      "examples": [
        {
          "en": "No dough, no luck — classic tango arithmetic.",
          "es": "Sin guita y sin suerte — la cuenta clásica del tango.",
          "zh": "没钱没运气——经典探戈的算术。"
        }
      ],
      "relationships": []
    },
    {
      "conceptId": "laburo",
      "domainId": "rio-tango",
      "areaIds": [
        "lunfardo-basics"
      ],
      "difficulty": 1,
      "competences": [
        "bilingual-terminology"
      ],
      "sourceIds": [
        "tango-culture"
      ],
      "inferred": false,
      "terms": {
        "en": {
          "term": "laburo (work, the grind)",
          "alternatives": [
            "job (slang)"
          ],
          "register": "slang"
        },
        "es": {
          "term": "laburo",
          "alternatives": [
            "trabajo"
          ],
          "register": "slang"
        },
        "zh": {
          "term": "活计（俚语）",
          "alternatives": [
            "laburo"
          ],
          "register": "slang"
        }
      },
      "definition": {
        "en": "From Italian 'lavoro' — work as the daily grind of the immigrant city, dignified and exhausting at once."
      },
      "distinctions": [
        {
          "contrast": "trabajo (neutral)",
          "difference": "Laburo smells of the factory whistle; 'employment' files it under HR."
        }
      ],
      "misconceptions": [
        {
          "tag": "laburo-neutral",
          "description": "Neutralising laburo",
          "diagnosticPrompt": "'El laburo me espera' at dawn — render the grind, not a calendar invite."
        }
      ],
      "examples": [
        {
          "en": "The grind waits at dawn, the milonga at night.",
          "es": "El laburo espera al alba, la milonga a la noche.",
          "zh": "活计在黎明等候，米隆加在夜晚。"
        }
      ],
      "relationships": []
    },
    {
      "conceptId": "arrabal",
      "domainId": "rio-tango",
      "areaIds": [
        "tango-themes"
      ],
      "difficulty": 2,
      "competences": [
        "domain-knowledge",
        "meaning-transfer"
      ],
      "sourceIds": [
        "tango-culture"
      ],
      "inferred": false,
      "terms": {
        "en": {
          "term": "arrabal (the old outskirts / barrio)",
          "alternatives": [
            "the old neighbourhood"
          ],
          "register": "cultural"
        },
        "es": {
          "term": "arrabal",
          "alternatives": [
            "barrio de las orillas"
          ],
          "register": "cultural"
        },
        "zh": {
          "term": "老城郊街区",
          "alternatives": [
            "arrabal"
          ],
          "register": "cultural"
        }
      },
      "definition": {
        "en": "The rough, beloved outskirts where tango was born — mud streets, faroles, compadritos — remembered as homeland, not slum."
      },
      "distinctions": [
        {
          "contrast": "suburb / slum",
          "difference": "Arrabal is pride and origin; 'slum' insults it, 'suburb' relocates it to lawns."
        }
      ],
      "misconceptions": [
        {
          "tag": "arrabal-as-slum",
          "description": "Translating arrabal as slum/suburb",
          "diagnosticPrompt": "'Mi arrabal querido' — the singer is homesick, not ashamed."
        }
      ],
      "examples": [
        {
          "en": "My beloved arrabal still waits at the corner.",
          "es": "Mi arrabal querido todavía espera en la esquina.",
          "zh": "我亲爱的老街区仍在街角等待。"
        }
      ],
      "relationships": []
    },
    {
      "conceptId": "bandoneon",
      "domainId": "rio-tango",
      "areaIds": [
        "tango-themes"
      ],
      "difficulty": 1,
      "competences": [
        "professional-terminology"
      ],
      "sourceIds": [
        "tango-culture"
      ],
      "inferred": false,
      "terms": {
        "en": {
          "term": "bandoneon (tango's button accordion)",
          "alternatives": [
            "bandoneón"
          ],
          "register": "cultural"
        },
        "es": {
          "term": "bandoneón",
          "alternatives": [
            "fueye"
          ],
          "register": "cultural"
        },
        "zh": {
          "term": "班多钮手风琴",
          "alternatives": [
            "探戈手风琴"
          ],
          "register": "cultural"
        }
      },
      "definition": {
        "en": "The German button accordion that became tango's breathing heart — nicknamed 'fueye' (bellows) because it sighs."
      },
      "distinctions": [
        {
          "contrast": "accordion (generic)",
          "difference": "Bandoneon is a specific instrument and a character in the lyrics; generic 'accordion' loses the sigh."
        }
      ],
      "misconceptions": [
        {
          "tag": "bandoneon-generic",
          "description": "Generic accordion rendering",
          "diagnosticPrompt": "'Llora el fueye' — the bellows weep; keep the instrument's name or its nickname's poetry."
        }
      ],
      "examples": [
        {
          "en": "The bandoneon sighs before the singer dares.",
          "es": "El bandoneón suspira antes de que el cantor se anime.",
          "zh": "班多钮在歌手开口前先叹息。"
        }
      ],
      "relationships": []
    },
    {
      "conceptId": "farol",
      "domainId": "rio-tango",
      "areaIds": [
        "tango-themes"
      ],
      "difficulty": 2,
      "competences": [
        "meaning-transfer"
      ],
      "sourceIds": [
        "tango-culture"
      ],
      "inferred": false,
      "terms": {
        "en": {
          "term": "farol (streetlamp of memory)",
          "alternatives": [
            "the old streetlamp"
          ],
          "register": "cultural"
        },
        "es": {
          "term": "farol",
          "alternatives": [
            "farol de la esquina"
          ],
          "register": "cultural"
        },
        "zh": {
          "term": "街灯（记忆的）",
          "alternatives": [
            "farol"
          ],
          "register": "cultural"
        }
      },
      "definition": {
        "en": "The corner streetlamp under which tango assignations, serenades and farewells happen — a lighthouse for the barrio's memory."
      },
      "distinctions": [
        {
          "contrast": "streetlight (municipal)",
          "difference": "Farol is a rendezvous and a witness; municipal 'streetlight' reports infrastructure."
        }
      ],
      "misconceptions": [
        {
          "tag": "farol-literal",
          "description": "Literal streetlight rendering",
          "diagnosticPrompt": "'Bajo el farol' — lovers met there; keep the tryst in the translation."
        }
      ],
      "examples": [
        {
          "en": "Under the farol, the barrio keeps its promises.",
          "es": "Bajo el farol, el barrio guarda sus promesas.",
          "zh": "在街灯下，街区守着它的承诺。"
        }
      ],
      "relationships": []
    },
    {
      "conceptId": "milonga",
      "domainId": "rio-tango",
      "areaIds": [
        "listening-classics"
      ],
      "difficulty": 2,
      "competences": [
        "domain-knowledge"
      ],
      "sourceIds": [
        "tango-culture"
      ],
      "inferred": false,
      "terms": {
        "en": {
          "term": "milonga (dance hall / fast tango rhythm)",
          "alternatives": [
            "tango dance night"
          ],
          "register": "cultural"
        },
        "es": {
          "term": "milonga",
          "alternatives": [
            "salón de tango"
          ],
          "register": "cultural"
        },
        "zh": {
          "term": "米隆加（探戈舞会）",
          "alternatives": [
            "milonga"
          ],
          "register": "cultural"
        }
      },
      "definition": {
        "en": "Both the lively 2/4 rhythm and the dance night itself — the social room where tango lives, with its códigos of invitation (cabeceo)."
      },
      "distinctions": [
        {
          "contrast": "tango show / club",
          "difference": "A milonga is participatory and rule-governed (cabeceo, tandas, cortinas); a 'club night' misses the etiquette that is the culture."
        }
      ],
      "misconceptions": [
        {
          "tag": "milonga-as-club",
          "description": "Milonga as generic nightclub",
          "diagnosticPrompt": "Explain a milonga to a visitor: the cabeceo nod is the invitation — translate the ritual."
        }
      ],
      "examples": [
        {
          "en": "At the milonga, a nod is an invitation and a tanda is a promise.",
          "es": "En la milonga, un cabeceo es una invitación y una tanda una promesa.",
          "zh": "在米隆加，点头是邀请，一组舞曲是承诺。"
        }
      ],
      "relationships": []
    }
  ]
