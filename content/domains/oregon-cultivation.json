        "osu-extension"
      ],
      "inferred": false,
      "terms": {
        "en": {
          "term": "harvest window",
          "alternatives": [],
          "register": "professional/agricultural"
        },
        "es": {
          "term": "ventana de cosecha",
          "alternatives": [
            "periodo óptimo de cosecha"
          ],
          "register": "professional/agricultural"
        },
        "zh": {
          "term": "收获窗口期",
          "alternatives": [
            "最佳收获期"
          ],
          "register": "professional/agricultural"
        }
      },
      "definition": {
        "en": "The limited period when the crop meets quality and market standards — early loses yield, late loses grade."
      },
      "distinctions": [
        {
          "contrast": "harvest date (single day)",
          "difference": "A window is a range judged by readiness signs; a single date ignores weather and ripening spread."
        }
      ],
      "misconceptions": [],
      "examples": [
        {
          "en": "The harvest window opens next week, judged by color and firmness, not the calendar alone.",
          "es": "La ventana de cosecha se abre la próxima semana, según color y firmeza, no solo el calendario.",
          "zh": "收获窗口期下周开启，按颜色和硬度判断，不只看日历。"
        }
      ],
      "relationships": []
    },
    {
      "conceptId": "traceability",
      "domainId": "oregon-cultivation",
      "areaIds": [
        "harvest-records"
      ],
      "difficulty": 2,
      "competences": [
        "domain-knowledge"
      ],
      "sourceIds": [
        "osu-extension"
      ],
      "inferred": false,
      "terms": {
        "en": {
          "term": "traceability (lot tracking)",
          "alternatives": [
            "lot traceability"
          ],
          "register": "institutional"
        },
        "es": {
          "term": "trazabilidad (por lotes)",
          "alternatives": [],
          "register": "institutional"
        },
        "zh": {
          "term": "可追溯性（批次追踪）",
          "alternatives": [],
          "register": "institutional"
        }
      },
      "definition": {
        "en": "Records linking each harvested lot back to field, date, and handling so problems can be isolated and recalled precisely."
      },
      "distinctions": [
        {
          "contrast": "general farm diary",
          "difference": "Traceability is lot-specific and auditable; a diary is narrative. Buyers and inspectors need the lot chain."
        }
      ],
      "misconceptions": [],
      "examples": [
        {
          "en": "Keep lot records so traceability holds from field to buyer.",
          "es": "Mantenga registros por lote para que la trazabilidad se mantenga del campo al comprador.",
          "zh": "保留批次记录，确保从田间到买家的可追溯性。"
        }
      ],
      "relationships": []
    }
  ]
