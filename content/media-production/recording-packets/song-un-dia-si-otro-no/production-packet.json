    },
    {
      "lineId": "cue-004",
      "type": "production-cue",
      "text": "Verso 1",
      "requiresHumanMix": true
    },
    {
      "lineId": "line-005",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "Mi vecino puso un reloj en la cocina,",
      "estimatedMs": 3556,
      "source": "narrative-body"
    },
    {
      "lineId": "line-006",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "le dio cuerda con un beso y un café.",
      "estimatedMs": 4000,
      "source": "narrative-body"
    },
    {
      "lineId": "line-007",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "La mañana se reía en la cortina,",
      "estimatedMs": 3111,
      "source": "narrative-body"
    },
    {
      "lineId": "line-008",
      "speaker": "él decía",
      "language": "unconfirmed",
      "text": "«Lo entendí». Yo dije: «¿Qué?»",
      "estimatedMs": 2222,
      "source": "parsed-script-label"
    },
    {
      "lineId": "cue-009",
      "type": "production-cue",
      "text": "Pre-coro",
      "requiresHumanMix": true
    },
    {
      "lineId": "line-010",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "No es igual cuánto tomas",
      "estimatedMs": 2222,
      "source": "narrative-body"
    },
    {
      "lineId": "line-011",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "que la hora de tomar.",
      "estimatedMs": 2222,
      "source": "narrative-body"
    },
    {
      "lineId": "line-012",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "Una cosa es la cantidad,",
      "estimatedMs": 2222,
      "source": "narrative-body"
    },
    {
      "lineId": "line-013",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "otra, cuándo volverá.",
      "estimatedMs": 1333,
      "source": "narrative-body"
    },
    {
      "lineId": "cue-014",
      "type": "production-cue",
      "text": "Coro",
      "requiresHumanMix": true
    },
    {
      "lineId": "line-015",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "Un día sí, otro no,",
      "estimatedMs": 2222,
      "source": "narrative-body"
    },
    {
      "lineId": "line-016",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "no es dos veces por día.",
      "estimatedMs": 2667,
      "source": "narrative-body"
    },
    {
      "lineId": "line-017",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "No me cambies el reloj,",
      "estimatedMs": 2222,
      "source": "narrative-body"
    },
    {
      "lineId": "line-018",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "ni me borres la medida.",
      "estimatedMs": 2222,
      "source": "narrative-body"
    },
    {
      "lineId": "line-019",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "Uno es uno, dos es dos,",
      "estimatedMs": 2667,
      "source": "narrative-body"
    },
    {
      "lineId": "line-020",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "las palabras tienen vida.",
      "estimatedMs": 1778,
      "source": "narrative-body"
    },
    {
      "lineId": "line-021",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "Si no queda claro el ritmo,",
      "estimatedMs": 2667,
      "source": "narrative-body"
    },
    {
      "lineId": "line-022",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "que lo explique quien lo indica.",
      "estimatedMs": 2667,
      "source": "narrative-body"
    },
    {
      "lineId": "cue-023",
      "type": "production-cue",
      "text": "Verso 2",
      "requiresHumanMix": true
    },
    {
      "lineId": "line-024",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "La vecina, que tocaba la campana,",
      "estimatedMs": 2667,
      "source": "narrative-body"
    },
    {
      "lineId": "line-025",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "confundió el martes con viernes al pasar.",
      "estimatedMs": 3111,
      "source": "narrative-body"
    },
    {
      "lineId": "line-026",
      "speaker": "NARRATOR",
      "language": "unconfirmed",
      "text": "«Yo te mando el recordatorio por la mañana»,",
      "estimatedMs": 3556,
      "source": "narrative-body"
    },
    {
