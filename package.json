{
  "name": "entrevoces",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "File-based knowledge and game generation with deterministic learning and game runtimes.",
  "scripts": {
    "generate": "node tools/generate.mjs",
    "agents": "node tools/generate.mjs agents",
    "doctor": "node tools/generate.mjs doctor",
    "validate": "node tools/generate.mjs validate",
    "test": "node --test tests/*.test.js",
    "audit:kb": "node tools/audit/kb-audit.mjs",
    "knowledge:build": "node tools/build-interpreter-library.mjs",
    "build": "node tools/build-hub.mjs",
    "hub": "python3 -m http.server 8014 --bind 127.0.0.1 --directory dist",
    "suite:build": "node tools/build-suite.mjs",
    "audit:samples": "node tools/audit/seed-audit.mjs"
  }
}
