{
  "name": "entrevoces",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "File-based knowledge and game generation with deterministic learning and game runtimes.",
  "scripts": {
    "generate": "node tools/generate.mjs",
    "agents": "node tools/generate.mjs agents",
    "doctor": "node tools/generate.mjs doctor",
    "validate": "node tools/generate.mjs validate",
    "test": "node --test tests/*.test.js",
    "audit:kb": "node tools/audit/kb-audit.mjs",
    "knowledge:build": "node tools/build-interpreter-library.mjs",
    "build": "node tools/build-hub.mjs",
    "hub": "python3 -m http.server 8014 --bind 127.0.0.1 --directory dist",
    "hub:spoken": "npm run hub",
    "hub:legacy-muse": "node services/spoken-gateway/server.js",
    "modal:check": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -p 'test_modal_*.py' -v",
    "spoken:calibrate": "node tools/calibrate-spoken.mjs",
    "suite:build": "node tools/build-suite.mjs",
    "audit:samples": "node tools/audit/seed-audit.mjs",
    "pretest": "npm run build",
    "verify:site": "node tools/verify-site.mjs",
    "media:studio": "node tools/media-studio.mjs",
    "media:audit": "node tools/media-studio.mjs audit",
    "media:queue": "node tools/media-studio.mjs queue",
    "media:packets": "node tools/media-recording-packets.mjs",
    "media:test": "node --test tests/media-first.test.js tests/media-professional.test.js tests/media-quality-v2.test.js tests/media-voice-production.test.js tests/media-stage-schemas.test.js tests/media-legacy-audit.test.js tests/meta-real-contract.test.js tests/meta-workflows.test.js",
    "meta:dry": "node tools/meta-live-verify.mjs --dry-run"
  }
}
